{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vgent",
  "version": "0.1.212",
  "identifier": "dev.vgent.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-desktop.mjs",
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/vgent-node"
    ],
    "resources": {
      "resources/server/": "server/",
      "resources/web/": "web/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Xiaodong Deng (UVZM439VGU)",
      "hardenedRuntime": false
    }
  }
}
