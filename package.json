{
  "name": "vgent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "start": "pnpm build && pnpm --filter @vgent/web build && node packages/server/dist/main.js",
    "server": "node packages/server/dist/main.js",
    "desktop:build": "pnpm --filter @vgent/desktop build",
    "desktop:dev": "pnpm --filter @vgent/desktop dev",
    "test:watch": "vitest",
    "clean": "rm -rf packages/*/dist apps/*/dist"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "tsx": "4.23.13",
    "@types/node": "22.20.3"
  }
}
